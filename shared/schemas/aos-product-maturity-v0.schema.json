{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/aos-product-maturity-v0.schema.json",
  "title": "AOS Product Maturity V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "product",
    "maturity",
    "distribution",
    "migration_policy",
    "compatibility_policy",
    "compatibility_exceptions"
  ],
  "properties": {
    "$schema": {
      "const": "../../shared/schemas/aos-product-maturity-v0.schema.json"
    },
    "schema_version": {
      "const": "aos.product-maturity.v0"
    },
    "product": {
      "const": "agent-os"
    },
    "maturity": {
      "const": "pre_release"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ever_distributed",
        "external_installed_base",
        "external_compatibility_obligations"
      ],
      "properties": {
        "ever_distributed": { "const": false },
        "external_installed_base": { "const": false },
        "external_compatibility_obligations": { "const": false }
      }
    },
    "migration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_consumers", "superseded_implementation"],
      "properties": {
        "internal_consumers": { "const": "atomic" },
        "superseded_implementation": { "const": "delete_same_change" }
      }
    },
    "compatibility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_action", "allowed_evidence", "residue_marker"],
      "properties": {
        "default_action": { "const": "delete_superseded_same_change" },
        "allowed_evidence": {
          "const": ["external_consumer", "persisted_data_dependency"]
        },
        "residue_marker": { "const": "AOS_COMPATIBILITY_RESIDUE:" }
      }
    },
    "compatibility_exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/compatibility_exception" }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "compatibility_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "justification",
        "evidence",
        "active_paths",
        "removal",
        "regression_tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "owner": { "$ref": "#/$defs/non_empty_string" },
        "justification": { "$ref": "#/$defs/non_empty_string" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {
              "enum": ["external_consumer", "persisted_data_dependency"]
            },
            "reference": { "$ref": "#/$defs/non_empty_string" }
          }
        },
        "active_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_path" }
        },
        "removal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": { "$ref": "#/$defs/non_empty_string" },
            "milestone": { "$ref": "#/$defs/non_empty_string" }
          },
          "anyOf": [
            { "required": ["condition"] },
            { "required": ["milestone"] }
          ]
        },
        "regression_tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/repo_path" },
              { "pattern": "^tests/" }
            ]
          }
        }
      }
    }
  }
}
