{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelblum/agent-os/shared/schemas/display-topology-v1.schema.json",
  "title": "AOS Display Topology",
  "description": "Closed, content-addressed mapping facts for one immutable active-display observation.",
  "type": "object",
  "required": [
    "schema",
    "identity",
    "uses_display_id_fallback",
    "screens_have_separate_spaces",
    "desktop_world_origin_native",
    "native_bounds",
    "native_visible_bounds",
    "desktop_world_bounds",
    "visible_desktop_world_bounds",
    "displays"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aos.display-topology.v1" },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uses_display_id_fallback": { "type": "boolean" },
    "screens_have_separate_spaces": { "type": "boolean" },
    "desktop_world_origin_native": { "$ref": "#/$defs/Point" },
    "native_bounds": { "$ref": "#/$defs/PositiveBounds" },
    "native_visible_bounds": { "$ref": "#/$defs/Bounds" },
    "desktop_world_bounds": { "$ref": "#/$defs/PositiveBounds" },
    "visible_desktop_world_bounds": { "$ref": "#/$defs/Bounds" },
    "displays": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Display" }
    }
  },
  "$defs": {
    "Point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "Bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "PositiveBounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "MemberIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "display_uuid"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "display_uuid" },
            "display_uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "display_id_fallback"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "display_id_fallback" },
            "display_id_fallback": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        }
      ]
    },
    "Display": {
      "type": "object",
      "required": [
        "ordinal",
        "is_main",
        "member_identity",
        "native_bounds",
        "native_visible_bounds",
        "desktop_world_bounds",
        "visible_desktop_world_bounds",
        "scale_factor",
        "rotation"
      ],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "is_main": { "type": "boolean" },
        "member_identity": { "$ref": "#/$defs/MemberIdentity" },
        "native_bounds": { "$ref": "#/$defs/PositiveBounds" },
        "native_visible_bounds": { "$ref": "#/$defs/Bounds" },
        "desktop_world_bounds": { "$ref": "#/$defs/PositiveBounds" },
        "visible_desktop_world_bounds": { "$ref": "#/$defs/Bounds" },
        "scale_factor": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    }
  }
}
