{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json",
  "title": "AOS fixed and caller-followed screen recording v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/follow_update_request"},
    {"$ref": "#/$defs/admission_result"},
    {"$ref": "#/$defs/follow_update_result"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/completion_result"}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tracks": {
      "type": "object",
      "required": ["video", "system_audio", "microphone"],
      "properties": {
        "video": {"const": true},
        "system_audio": {"type": "boolean"},
        "microphone": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "track_name": {"enum": ["video", "system_audio", "microphone"]},
    "track_truth": {
      "type": "object",
      "required": [
        "selected", "admitted", "available", "first_sample_present",
        "sample_count", "sample_byte_count", "failure_code", "drained", "finalized"
      ],
      "properties": {
        "selected": {"type": "boolean"},
        "admitted": {"type": "boolean"},
        "available": {"type": "boolean"},
        "first_sample_present": {"type": "boolean"},
        "sample_count": {"$ref": "#/$defs/count"},
        "sample_byte_count": {"$ref": "#/$defs/count"},
        "failure_code": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"}
          ]
        },
        "drained": {"type": "boolean"},
        "finalized": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"first_sample_present": {"const": true}}},
          "then": {
            "properties": {
              "available": {"const": true},
              "sample_count": {"$ref": "#/$defs/positive_count"},
              "sample_byte_count": {"$ref": "#/$defs/positive_count"}
            }
          },
          "else": {
            "properties": {
              "sample_count": {"const": 0},
              "sample_byte_count": {"const": 0}
            }
          }
        },
        {
          "if": {"properties": {"finalized": {"const": true}}},
          "then": {"properties": {"drained": {"const": true}}}
        },
        {
          "if": {
            "properties": {
              "selected": {"const": true},
              "finalized": {"const": true}
            }
          },
          "then": {
            "properties": {
              "admitted": {"const": true},
              "available": {"const": true},
              "first_sample_present": {"const": true},
              "sample_count": {"$ref": "#/$defs/positive_count"},
              "sample_byte_count": {"$ref": "#/$defs/positive_count"},
              "failure_code": {"type": "null"},
              "drained": {"const": true}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "successful_track_truth": {
      "properties": {
        "selected": {"const": true},
        "admitted": {"const": true},
        "available": {"const": true},
        "first_sample_present": {"const": true},
        "sample_count": {"$ref": "#/$defs/positive_count"},
        "sample_byte_count": {"$ref": "#/$defs/positive_count"},
        "failure_code": {"type": "null"},
        "drained": {"const": true},
        "finalized": {"const": true}
      }
    },
    "inert_track_truth": {
      "properties": {
        "selected": {"const": false},
        "admitted": {"const": false},
        "available": {"const": false},
        "first_sample_present": {"const": false},
        "sample_count": {"const": 0},
        "sample_byte_count": {"const": 0},
        "failure_code": {"type": "null"},
        "drained": {"const": true},
        "finalized": {"const": true}
      }
    },
    "successful_track_summary": {
      "allOf": [
        {"$ref": "#/$defs/track_summary"},
        {
          "properties": {
            "common_media_epoch_ns": {"$ref": "#/$defs/count"},
            "video": {"$ref": "#/$defs/successful_track_truth"}
          },
          "oneOf": [
            {
              "properties": {
                "selected_tracks": {"const": ["video"]},
                "finalized_tracks": {"const": ["video"]},
                "system_audio": {"$ref": "#/$defs/inert_track_truth"},
                "microphone": {"$ref": "#/$defs/inert_track_truth"}
              }
            },
            {
              "properties": {
                "selected_tracks": {"const": ["video", "system_audio"]},
                "finalized_tracks": {"const": ["video", "system_audio"]},
                "system_audio": {"$ref": "#/$defs/successful_track_truth"},
                "microphone": {"$ref": "#/$defs/inert_track_truth"}
              }
            },
            {
              "properties": {
                "selected_tracks": {"const": ["video", "microphone"]},
                "finalized_tracks": {"const": ["video", "microphone"]},
                "system_audio": {"$ref": "#/$defs/inert_track_truth"},
                "microphone": {"$ref": "#/$defs/successful_track_truth"}
              }
            },
            {
              "properties": {
                "selected_tracks": {"const": ["video", "system_audio", "microphone"]},
                "finalized_tracks": {"const": ["video", "system_audio", "microphone"]},
                "system_audio": {"$ref": "#/$defs/successful_track_truth"},
                "microphone": {"$ref": "#/$defs/successful_track_truth"}
              }
            }
          ]
        }
      ]
    },
    "tracks_summary_binding": {
      "oneOf": [
        {
          "properties": {
            "tracks": {"properties": {"system_audio": {"const": false}, "microphone": {"const": false}}},
            "track_summary": {"properties": {"selected_tracks": {"const": ["video"]}}}
          }
        },
        {
          "properties": {
            "tracks": {"properties": {"system_audio": {"const": true}, "microphone": {"const": false}}},
            "track_summary": {"properties": {"selected_tracks": {"const": ["video", "system_audio"]}}}
          }
        },
        {
          "properties": {
            "tracks": {"properties": {"system_audio": {"const": false}, "microphone": {"const": true}}},
            "track_summary": {"properties": {"selected_tracks": {"const": ["video", "microphone"]}}}
          }
        },
        {
          "properties": {
            "tracks": {"properties": {"system_audio": {"const": true}, "microphone": {"const": true}}},
            "track_summary": {"properties": {"selected_tracks": {"const": ["video", "system_audio", "microphone"]}}}
          }
        }
      ]
    },
    "selected_track_set": {
      "oneOf": [
        {"const": ["video"]},
        {"const": ["video", "system_audio"]},
        {"const": ["video", "microphone"]},
        {"const": ["video", "system_audio", "microphone"]}
      ]
    },
    "track_set": {
      "oneOf": [
        {"const": []},
        {"const": ["video"]},
        {"const": ["video", "system_audio"]},
        {"const": ["video", "microphone"]},
        {"const": ["video", "system_audio", "microphone"]}
      ]
    },
    "track_summary": {
      "type": "object",
      "required": [
        "selected_tracks", "finalized_tracks", "common_media_epoch_ns",
        "video", "system_audio", "microphone"
      ],
      "properties": {
        "selected_tracks": {"$ref": "#/$defs/selected_track_set"},
        "finalized_tracks": {"$ref": "#/$defs/track_set"},
        "common_media_epoch_ns": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]
        },
        "video": {"$ref": "#/$defs/track_truth"},
        "system_audio": {"$ref": "#/$defs/track_truth"},
        "microphone": {"$ref": "#/$defs/track_truth"}
      },
      "allOf": [
        {
          "properties": {
            "video": {"properties": {"selected": {"const": true}, "admitted": {"const": true}}}
          },
          "oneOf": [
            {
              "properties": {
                "selected_tracks": {"const": ["video"]},
                "finalized_tracks": {"enum": [[], ["video"]]},
                "system_audio": {"$ref": "#/$defs/inert_track_truth"},
                "microphone": {"$ref": "#/$defs/inert_track_truth"}
              }
            },
            {
              "properties": {
                "selected_tracks": {"const": ["video", "system_audio"]},
                "finalized_tracks": {"enum": [[], ["video"], ["video", "system_audio"]]},
                "system_audio": {"properties": {"selected": {"const": true}, "admitted": {"const": true}}},
                "microphone": {"$ref": "#/$defs/inert_track_truth"}
              }
            },
            {
              "properties": {
                "selected_tracks": {"const": ["video", "microphone"]},
                "finalized_tracks": {"enum": [[], ["video"], ["video", "microphone"]]},
                "system_audio": {"$ref": "#/$defs/inert_track_truth"},
                "microphone": {"properties": {"selected": {"const": true}, "admitted": {"const": true}}}
              }
            },
            {
              "properties": {
                "selected_tracks": {"const": ["video", "system_audio", "microphone"]},
                "finalized_tracks": {"enum": [[], ["video"], ["video", "system_audio"], ["video", "system_audio", "microphone"]]},
                "system_audio": {"properties": {"selected": {"const": true}, "admitted": {"const": true}}},
                "microphone": {"properties": {"selected": {"const": true}, "admitted": {"const": true}}}
              }
            }
          ]
        },
        {
          "if": {"properties": {"finalized_tracks": {"const": []}}},
          "then": {"properties": {
            "video": {"properties": {"finalized": {"const": false}}},
            "system_audio": {"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"finalized": {"const": false}}}},
            "microphone": {"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"finalized": {"const": false}}}}
          }}
        },
        {
          "if": {"properties": {"finalized_tracks": {"const": ["video"]}}},
          "then": {"properties": {
            "video": {"properties": {"finalized": {"const": true}}},
            "system_audio": {"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"finalized": {"const": false}}}},
            "microphone": {"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"finalized": {"const": false}}}}
          }}
        },
        {
          "if": {"properties": {"finalized_tracks": {"const": ["video", "system_audio"]}}},
          "then": {"properties": {
            "video": {"properties": {"finalized": {"const": true}}},
            "system_audio": {"properties": {"finalized": {"const": true}}},
            "microphone": {"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"finalized": {"const": false}}}}
          }}
        },
        {
          "if": {"properties": {"finalized_tracks": {"const": ["video", "microphone"]}}},
          "then": {"properties": {
            "video": {"properties": {"finalized": {"const": true}}},
            "microphone": {"properties": {"finalized": {"const": true}}}
          }}
        },
        {
          "if": {"properties": {"finalized_tracks": {"const": ["video", "system_audio", "microphone"]}}},
          "then": {"properties": {
            "video": {"properties": {"finalized": {"const": true}}},
            "system_audio": {"properties": {"finalized": {"const": true}}},
            "microphone": {"properties": {"finalized": {"const": true}}}
          }}
        }
      ],
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "display_target": {
      "type": "object",
      "required": ["kind", "display_ordinal"],
      "properties": {
        "kind": {"const": "display"},
        "display_ordinal": {"type": "integer", "minimum": 0, "maximum": 15}
      },
      "additionalProperties": false
    },
    "window_target": {
      "type": "object",
      "required": ["kind", "display_ordinal", "window_id", "owner_pid", "global_bounds"],
      "properties": {
        "kind": {"const": "window"},
        "display_ordinal": {"type": "integer", "minimum": 0, "maximum": 15},
        "window_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "owner_pid": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "global_bounds": {"$ref": "#/$defs/bounds"}
      },
      "additionalProperties": false
    },
    "region_target": {
      "type": "object",
      "required": ["kind", "display_ordinal", "global_bounds"],
      "properties": {
        "kind": {"const": "region"},
        "display_ordinal": {"type": "integer", "minimum": 0, "maximum": 15},
        "global_bounds": {"$ref": "#/$defs/bounds"}
      },
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/display_target"},
        {"$ref": "#/$defs/window_target"},
        {"$ref": "#/$defs/region_target"}
      ]
    },
    "binding_identity": {
      "type": "object",
      "required": ["id", "generation"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "follow_binding": {
      "type": "object",
      "required": [
        "target", "observation", "state", "session", "navigation", "frame",
        "source_window"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/binding_identity"},
        "observation": {"$ref": "#/$defs/binding_identity"},
        "state": {"$ref": "#/$defs/binding_identity"},
        "session": {"$ref": "#/$defs/binding_identity"},
        "navigation": {"$ref": "#/$defs/binding_identity"},
        "frame": {"$ref": "#/$defs/binding_identity"},
        "source_window": {
          "type": "object",
          "required": ["window_id", "owner_pid"],
          "properties": {
            "window_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "owner_pid": {"type": "integer", "minimum": 1, "maximum": 2147483647}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "geometry_configuration": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "fixed"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "binding", "update_interval_ms", "update_deadline_ms"],
          "properties": {
            "mode": {"const": "caller_followed"},
            "binding": {"$ref": "#/$defs/follow_binding"},
            "update_interval_ms": {"type": "integer", "minimum": 16, "maximum": 10000},
            "update_deadline_ms": {"type": "integer", "minimum": 16, "maximum": 60000}
          },
          "additionalProperties": false
        }
      ]
    },
    "geometry_truth": {
      "type": "object",
      "required": [
        "mode", "geometry_generation", "binding_digest", "source_rect",
        "pixel_width", "pixel_height", "update_interval_ms", "update_deadline_ms",
        "last_accepted_observation_generation", "last_accepted_state_generation",
        "pending_update", "next_deadline"
      ],
      "properties": {
        "mode": {"enum": ["fixed", "caller_followed"]},
        "geometry_generation": {"$ref": "#/$defs/generation"},
        "binding_digest": {"$ref": "#/$defs/sha256"},
        "source_rect": {"$ref": "#/$defs/bounds"},
        "pixel_width": {"type": "integer", "minimum": 2},
        "pixel_height": {"type": "integer", "minimum": 2},
        "update_interval_ms": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 16, "maximum": 10000}]},
        "update_deadline_ms": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 16, "maximum": 60000}]},
        "last_accepted_observation_generation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/generation"}]},
        "last_accepted_state_generation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/generation"}]},
        "pending_update": {"type": "boolean"},
        "next_deadline": {
          "type": "object",
          "required": ["state", "not_before_monotonic_ns", "deadline_monotonic_ns"],
          "properties": {
            "state": {"enum": ["not_applicable", "inactive", "armed", "expired", "stopped"]},
            "not_before_monotonic_ns": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
            "deadline_monotonic_ns": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "fixed"}}},
          "then": {"properties": {
            "geometry_generation": {"const": 1},
            "update_interval_ms": {"type": "null"},
            "update_deadline_ms": {"type": "null"},
            "last_accepted_observation_generation": {"type": "null"},
            "last_accepted_state_generation": {"type": "null"},
            "pending_update": {"const": false},
            "next_deadline": {"properties": {"state": {"const": "not_applicable"}}}
          }}
        }
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "schema_version", "request_id", "canonical_parameter_digest", "topology", "target",
        "geometry", "duration_ms", "frame_rate", "max_pixel_count", "max_queue_frames",
        "max_output_bytes", "tracks", "codec", "container"
      ],
      "properties": {
        "schema_version": {"const": "aos.screen-recording.request.v1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "canonical_parameter_digest": {"$ref": "#/$defs/sha256"},
        "topology": {"$ref": "https://github.com/michaelblum/agent-os/shared/schemas/display-topology-v1.schema.json"},
        "target": {"$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json#/$defs/target"},
        "geometry": {"$ref": "#/$defs/geometry_configuration"},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "frame_rate": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_pixel_count": {"type": "integer", "minimum": 4, "maximum": 33177600},
        "max_queue_frames": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "tracks": {"$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json#/$defs/tracks"},
        "codec": {"const": "h264"},
        "container": {"const": "quicktime"}
      },
      "allOf": [
        {
          "if": {"properties": {"geometry": {"properties": {"mode": {"const": "caller_followed"}}}}},
          "then": {"properties": {"target": {"$ref": "#/$defs/region_target"}}}
        }
      ],
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "required": ["operation_id", "operation_generation"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/identifier"},
        "operation_generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "stream_selector": {
      "type": "object",
      "required": ["stream_id", "stream_generation"],
      "properties": {
        "stream_id": {"$ref": "#/$defs/identifier"},
        "stream_generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "artifact_selector": {
      "type": "object",
      "required": ["artifact_id", "artifact_generation"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "artifact_generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "follow_update_request": {
      "type": "object",
      "required": [
        "request_id", "canonical_parameter_digest", "selector",
        "expected_geometry_generation", "topology", "target", "binding"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "canonical_parameter_digest": {"$ref": "#/$defs/sha256"},
        "selector": {"$ref": "#/$defs/selector"},
        "expected_geometry_generation": {"$ref": "#/$defs/generation"},
        "topology": {"$ref": "https://github.com/michaelblum/agent-os/shared/schemas/display-topology-v1.schema.json"},
        "target": {"$ref": "#/$defs/region_target"},
        "binding": {"$ref": "#/$defs/follow_binding"}
      },
      "additionalProperties": false
    },
    "admission_result": {
      "type": "object",
      "required": [
        "schema_version", "operation", "stream", "artifact", "daemon_generation",
        "geometry", "tracks", "track_summary", "codec", "container"
      ],
      "properties": {
        "schema_version": {"const": "aos.screen-recording.admission-result.v1"},
        "operation": {"$ref": "#/$defs/selector"},
        "stream": {"$ref": "#/$defs/stream_selector"},
        "artifact": {"$ref": "#/$defs/artifact_selector"},
        "daemon_generation": {"$ref": "#/$defs/generation"},
        "geometry": {"$ref": "#/$defs/geometry_truth"},
        "tracks": {"$ref": "#/$defs/tracks"},
        "track_summary": {"$ref": "#/$defs/track_summary"},
        "codec": {"const": "h264"},
        "container": {"const": "quicktime"}
      },
      "allOf": [{"$ref": "#/$defs/tracks_summary_binding"}],
      "additionalProperties": false
    },
    "follow_update_result": {
      "type": "object",
      "required": ["schema_version", "operation", "geometry"],
      "properties": {
        "schema_version": {"const": "aos.screen-recording.follow-update-result.v1"},
        "operation": {"$ref": "#/$defs/selector"},
        "geometry": {"$ref": "#/$defs/geometry_truth"}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "schema_version", "operation", "frame_count", "byte_count", "elapsed_ms",
        "dropped_frame_count", "tracks", "track_summary", "geometry"
      ],
      "properties": {
        "schema_version": {"const": "aos.screen-recording.progress.v1"},
        "operation": {"$ref": "#/$defs/selector"},
        "frame_count": {"$ref": "#/$defs/count"},
        "byte_count": {"$ref": "#/$defs/count"},
        "elapsed_ms": {"$ref": "#/$defs/count"},
        "dropped_frame_count": {"const": 0},
        "tracks": {"$ref": "#/$defs/tracks"},
        "track_summary": {"$ref": "#/$defs/track_summary"},
        "geometry": {"$ref": "#/$defs/geometry_truth"}
      },
      "allOf": [{"$ref": "#/$defs/tracks_summary_binding"}],
      "additionalProperties": false
    },
    "completion_result": {
      "type": "object",
      "required": [
        "schema_version", "operation", "artifact", "outcome", "frame_count", "byte_count",
        "duration_ms", "tracks", "track_summary", "geometry", "codec", "container", "cleanup_result"
      ],
      "properties": {
        "schema_version": {"const": "aos.screen-recording.result.v1"},
        "operation": {"$ref": "#/$defs/selector"},
        "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_selector"}]},
        "outcome": {"enum": ["succeeded", "cancelled", "killed", "failed", "timed_out"]},
        "frame_count": {"$ref": "#/$defs/count"},
        "byte_count": {"$ref": "#/$defs/count"},
        "duration_ms": {"$ref": "#/$defs/count"},
        "tracks": {"$ref": "#/$defs/tracks"},
        "track_summary": {"$ref": "#/$defs/track_summary"},
        "geometry": {"$ref": "#/$defs/geometry_truth"},
        "codec": {"const": "h264"},
        "container": {"const": "quicktime"},
        "cleanup_result": {"enum": ["zero_residuals", "residuals_present"]}
      },
      "allOf": [
        {"$ref": "#/$defs/tracks_summary_binding"},
        {
          "if": {"not": {"properties": {"artifact": {"type": "null"}}}},
          "then": {
            "properties": {
              "frame_count": {"$ref": "#/$defs/positive_count"},
