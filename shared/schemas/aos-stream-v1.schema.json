{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelblum/agent-os/shared/schemas/aos-stream-v1.schema.json",
  "title": "AOS Stream v1",
  "$ref": "#/$defs/stream_snapshot",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stream_selector": {
      "type": "object",
      "required": ["stream_id", "stream_generation"],
      "properties": {
        "stream_id": {"$ref": "#/$defs/identifier"},
        "stream_generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "source_identity": {
      "type": "object",
      "required": ["source_kind", "source_generation", "source_identity_digest"],
      "properties": {
        "source_kind": {
          "enum": ["native_capture", "native_event", "microphone", "managed_process", "external_process", "adapter"]
        },
        "source_generation": {"$ref": "#/$defs/generation"},
        "source_identity_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "transport_identity": {
      "type": "object",
      "required": ["transport_kind", "transport_generation", "transport_identity_digest"],
      "properties": {
        "transport_kind": {"enum": ["ipc", "native_callback", "child_stdio", "memory_queue", "artifact_sink"]},
        "transport_generation": {"$ref": "#/$defs/generation"},
        "transport_identity_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "stream_bounds": {
      "type": "object",
      "required": ["max_duration_ms", "max_bytes", "max_queue_items"],
      "properties": {
        "max_duration_ms": {"$ref": "#/$defs/positive_integer"},
        "max_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_queue_items": {"$ref": "#/$defs/positive_integer"}
      },
      "additionalProperties": false
    },
    "stream_counters": {
      "type": "object",
      "required": [
        "last_sequence",
        "source_items",
        "enqueued_items",
        "delivered_items",
        "enqueued_bytes",
        "delivered_bytes",
        "lost_items",
        "queue_high_water_items"
      ],
      "properties": {
        "last_sequence": {"$ref": "#/$defs/nonnegative_integer"},
        "source_items": {"$ref": "#/$defs/nonnegative_integer"},
        "enqueued_items": {"$ref": "#/$defs/nonnegative_integer"},
        "delivered_items": {"$ref": "#/$defs/nonnegative_integer"},
        "enqueued_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "delivered_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "lost_items": {"$ref": "#/$defs/nonnegative_integer"},
        "queue_high_water_items": {"$ref": "#/$defs/nonnegative_integer"}
      },
      "additionalProperties": false
    },
    "frontier": {
      "type": "object",
      "required": ["state", "next_sequence", "reason"],
      "properties": {
        "state": {"enum": ["open", "complete", "truncated", "source_lost"]},
        "next_sequence": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/positive_integer"}
          ]
        },
        "reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["active", "source_complete", "bound_reached", "transport_lost", "source_lost", "cleanup"]}
          ]
        }
      },
      "additionalProperties": false
    },
    "cleanup_summary": {
      "type": "object",
      "required": ["result", "residual_count", "residual_digest", "completed_at"],
      "properties": {
        "result": {
          "enum": ["not_started", "pending", "zero_residuals", "residuals_present", "recovery_active", "blocked_unresolved"]
        },
        "residual_count": {"$ref": "#/$defs/nonnegative_integer"},
        "residual_digest": {"$ref": "#/$defs/sha256"},
        "completed_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/timestamp"}
          ]
        }
      },
      "additionalProperties": false
    },
    "stream_terminal": {
      "type": "object",
      "required": ["outcome", "trigger", "completed_at"],
      "properties": {
        "outcome": {
          "enum": ["succeeded", "cancelled", "killed", "rejected", "failed", "crashed", "timed_out", "orphaned"]
        },
        "trigger": {
          "enum": [
            "adapter_complete",
            "caller_cancel",
            "kill_one",
            "owner_kill",
            "host_stop_all",
            "start_rejected",
            "start_failure",
            "deadline",
            "peer_lost",
            "transport_lost",
            "daemon_crash",
            "boot_recovery",
            "platform_failure",
            "permission_failure",
            "adapter_failure"
          ]
        },
        "completed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "child_reference": {
      "type": "object",
      "required": ["id", "generation"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "stream_snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "stream_id",
        "stream_generation",
        "operation_id",
        "operation_generation",
        "daemon_generation",
        "state",
        "source",
        "transport",
        "bounds",
        "counters",
        "frontier",
        "taps",
        "transient_data_retention",
        "cleanup",
        "terminal",
        "prepared_at",
        "activated_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {"const": "aos.stream.v1"},
        "stream_id": {"$ref": "#/$defs/identifier"},
        "stream_generation": {"$ref": "#/$defs/generation"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "operation_generation": {"$ref": "#/$defs/generation"},
        "daemon_generation": {"$ref": "#/$defs/generation"},
        "state": {
          "enum": ["prepared", "starting", "active", "stopping", "cleanup_required", "recovering", "terminal"]
        },
        "source": {"$ref": "#/$defs/source_identity"},
        "transport": {"$ref": "#/$defs/transport_identity"},
        "bounds": {"$ref": "#/$defs/stream_bounds"},
        "counters": {"$ref": "#/$defs/stream_counters"},
        "frontier": {"$ref": "#/$defs/frontier"},
        "taps": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/child_reference"}
        },
        "transient_data_retention": {"const": "none"},
        "cleanup": {"$ref": "#/$defs/cleanup_summary"},
        "terminal": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/stream_terminal"}
          ]
        },
        "prepared_at": {"$ref": "#/$defs/timestamp"},
        "activated_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/timestamp"}
          ]
        },
        "updated_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "terminal"}}},
          "then": {
            "properties": {
              "terminal": {"$ref": "#/$defs/stream_terminal"},
              "cleanup": {
                "properties": {
                  "result": {"const": "zero_residuals"},
                  "residual_count": {"const": 0},
                  "completed_at": {"$ref": "#/$defs/timestamp"}
                }
              }
            }
          },
          "else": {"properties": {"terminal": {"type": "null"}}}
        }
      ]
    }
  }
}
