{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelblum/agent-os/shared/schemas/daemon-request.schema.json",
  "title": "Daemon Request Envelope",
  "description": "Wire contract for requests sent to the aos daemon over its Unix socket. Newline-delimited JSON.",
  "type": "object",
  "required": ["v", "service", "action", "data"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "service": { "enum": ["see", "do", "show", "tell", "listen", "session", "voice", "permissions", "status_item", "scene", "system", "focus", "graph", "content", "operation"] },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "data": { "type": "object" },
    "asserted_attribution": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/asserted_attribution"
    },
    "ref": { "type": "string" }
  },
  "allOf": [
    { "if": { "required": ["asserted_attribution"] },
      "then": {
        "properties": {
          "service": { "const": "operation" },
          "action": { "const": "external_spawn_intent" }
        }
      } },
    { "if": { "properties": { "service": { "const": "operation" } } },
      "then": { "properties": { "action": { "enum": ["list", "inspect", "status", "recent", "cancel", "kill", "kill_owner", "record_screen", "record_screen_follow_update", "tap", "artifact_reveal", "artifact_remove", "artifact_release", "artifact_retain", "stop_all", "barrier_status", "reopen", "external_spawn_intent", "external_spawn_child_admit", "external_spawn_abandon", "external_spawn_finalize"] } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "record_screen" } } },
      "then": { "properties": { "data": { "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json#/$defs/request" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "record_screen_follow_update" } } },
      "then": { "properties": { "data": { "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json#/$defs/follow_update_request" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "external_spawn_intent" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnIntentRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "external_spawn_finalize" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnFinalizeRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "external_spawn_child_admit" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnChildAdmitRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "external_spawn_abandon" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnAbandonRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "enum": ["list", "recent", "kill_owner"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationFilterRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "enum": ["inspect", "status", "cancel", "kill"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationSelectorRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "tap" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationUnavailableRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "enum": ["artifact_reveal", "artifact_remove", "artifact_retain"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationArtifactSelectorRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "artifact_release" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/OperationArtifactReleaseRequestData" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "stop_all" } } },
      "then": { "properties": { "data": { "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-host-stop-barrier-v1.schema.json#/$defs/stop_all_request" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "reopen" } } },
      "then": { "properties": { "data": { "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-host-stop-barrier-v1.schema.json#/$defs/reopen_request" } } } },
    { "if": { "properties": { "service": { "const": "operation" }, "action": { "const": "barrier_status" } } },
      "then": { "properties": { "data": { "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-host-stop-barrier-v1.schema.json#/$defs/barrier_status_request" } } } },
    { "if": { "properties": { "service": { "const": "see" } } },
      "then": { "properties": { "action": { "enum": ["observe", "snapshot", "capture"] } } } },
    { "if": { "properties": { "service": { "const": "status_item" } } },
      "then": { "properties": { "action": { "enum": ["register", "update", "inspect", "invoke", "invoke_dry_run"] } } } },
    { "if": { "properties": { "service": { "const": "status_item" }, "action": { "const": "register" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/StatusItemRegisterData" } } } },
    { "if": { "properties": { "service": { "const": "status_item" }, "action": { "const": "update" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/StatusItemUpdateData" } } } },
    { "if": { "properties": { "service": { "const": "status_item" }, "action": { "const": "inspect" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/StatusItemInspectData" } } } },
    { "if": { "properties": { "service": { "const": "status_item" }, "action": { "enum": ["invoke", "invoke_dry_run"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/StatusItemInvokeData" } } } },
    { "if": { "properties": { "service": { "const": "see" }, "action": { "const": "observe" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/SeeObserveData" } } } },
    { "if": { "properties": { "service": { "const": "see" }, "action": { "const": "snapshot" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "see" }, "action": { "const": "capture" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/SeeCaptureData" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "create" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ShowCreateData" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "update" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ShowUpdateData" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "eval" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ShowEvalData" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "remove" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ShowRemoveData" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "remove_all" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "list" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ShowListData" } } } },
    { "if": { "properties": { "service": { "const": "show" }, "action": { "const": "post" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ShowPostData" } } } },
    { "if": { "properties": { "service": { "const": "tell" }, "action": { "const": "send" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/TellSendData" } } } },
    { "if": { "properties": { "service": { "const": "listen" }, "action": { "const": "read" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ListenReadData" } } } },
    { "if": { "properties": { "service": { "const": "listen" }, "action": { "const": "channels" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "session" }, "action": { "const": "register" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/SessionRegisterData" } } } },
    { "if": { "properties": { "service": { "const": "session" }, "action": { "const": "unregister" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/SessionUnregisterData" } } } },
    { "if": { "properties": { "service": { "const": "session" }, "action": { "const": "who" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "permissions" } } },
      "then": { "properties": { "action": { "enum": ["screen_capture_direct_status", "screen_capture_direct_prime"] } } } },
    { "if": { "properties": { "service": { "const": "permissions" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/EmptyStrict" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "list" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/VoiceListData" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "assignments" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "refresh" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "providers" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "bind" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/VoiceBindData" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "next" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/VoiceNextData" } } } },
    { "if": { "properties": { "service": { "const": "voice" }, "action": { "const": "final_response" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/VoiceFinalResponseData" } } } },
    { "if": { "properties": { "service": { "const": "scene" }, "action": { "const": "follow" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/SceneFollowData" } } } },
    { "if": { "properties": { "service": { "const": "system" }, "action": { "const": "ping" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "focus" }, "action": { "const": "list" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "focus" }, "action": { "const": "create" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/FocusCreateData" } } } },
    { "if": { "properties": { "service": { "const": "focus" }, "action": { "const": "update" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/FocusUpdateData" } } } },
    { "if": { "properties": { "service": { "const": "focus" }, "action": { "const": "remove" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/FocusRemoveData" } } } },
    { "if": { "properties": { "service": { "const": "graph" }, "action": { "const": "displays" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } },
    { "if": { "properties": { "service": { "const": "graph" }, "action": { "const": "windows" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/GraphWindowsData" } } } },
    { "if": { "properties": { "service": { "const": "graph" }, "action": { "const": "deepen" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/GraphDeepenData" } } } },
    { "if": { "properties": { "service": { "const": "graph" }, "action": { "const": "collapse" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/GraphCollapseData" } } } },
    { "if": { "properties": { "service": { "const": "content" }, "action": { "const": "status" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/Empty" } } } }
  ],
  "$defs": {
    "Empty": { "type": "object", "additionalProperties": true },
    "EmptyStrict": { "type": "object", "additionalProperties": false },
    "OperationIdentifier": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/identifier"
    },
    "OperationGeneration": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/generation"
    },
    "OperationSHA256": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/sha256"
    },
    "OperationExternalResolvedExecutable": {
      "type": "object",
      "required": ["resolved_path_digest", "executable_identity_digest", "device", "inode", "code_identity_digest", "file_digest", "platform_code_directory_hash", "signing_identifier", "signing_team_identifier"],
      "properties": {
        "resolved_path_digest": { "$ref": "#/$defs/OperationSHA256" },
        "executable_identity_digest": { "$ref": "#/$defs/OperationSHA256" },
        "device": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "inode": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "code_identity_digest": { "$ref": "#/$defs/OperationSHA256" },
        "file_digest": { "$ref": "#/$defs/OperationSHA256" },
        "platform_code_directory_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "signing_identifier": { "const": "node" },
        "signing_team_identifier": { "const": "HX7739G8FX" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnIntentRequestData": {
      "type": "object",
      "required": [
        "schema_version", "request_id", "route_source_id", "route_source_revision",
        "adapter_registration_id", "adapter_registration_revision", "resolved_executable",
        "expected_script_identity_digest", "expected_script_digest", "canonical_argv_shape_digest",
        "reviewed_dependency_set_digest"
      ],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-intent-request.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "route_source_id": { "$ref": "#/$defs/OperationIdentifier" },
        "route_source_revision": { "$ref": "#/$defs/OperationSHA256" },
        "adapter_registration_id": { "$ref": "#/$defs/OperationIdentifier" },
        "adapter_registration_revision": { "$ref": "#/$defs/OperationGeneration" },
        "resolved_executable": { "$ref": "#/$defs/OperationExternalResolvedExecutable" },
        "expected_script_identity_digest": { "$ref": "#/$defs/OperationSHA256" },
        "expected_script_digest": { "$ref": "#/$defs/OperationSHA256" },
        "canonical_argv_shape_digest": { "$ref": "#/$defs/OperationSHA256" },
        "reviewed_dependency_set_digest": { "$ref": "#/$defs/OperationSHA256" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnFinalizeRequestData": {
      "type": "object",
      "required": ["schema_version", "request_id"],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-finalize-request.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnChildAdmitRequestData": {
      "type": "object",
      "required": ["schema_version", "request_id", "one_time_binding_token", "child_pid"],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-child-admit-request.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "one_time_binding_token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "child_pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnAbandonRequestData": {
      "type": "object",
      "required": ["schema_version", "request_id", "one_time_binding_token"],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-abandon-request.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "one_time_binding_token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "additionalProperties": false
    },
    "OperationFilterRequestData": {
      "type": "object",
      "required": ["request_id", "canonical_parameter_digest", "filters"],
      "properties": {
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "canonical_parameter_digest": { "$ref": "#/$defs/OperationSHA256" },
        "filters": {
          "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-v1.schema.json#/$defs/owner_filters"
        }
      },
      "additionalProperties": false
    },
    "OperationSelectorRequestData": {
      "type": "object",
      "required": ["request_id", "canonical_parameter_digest", "selector"],
      "properties": {
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "canonical_parameter_digest": { "$ref": "#/$defs/OperationSHA256" },
        "selector": {
          "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-v1.schema.json#/$defs/operation_selector"
        }
      },
      "additionalProperties": false
    },
    "OperationUnavailableRequestData": {
      "type": "object",
      "required": ["request_id", "canonical_parameter_digest"],
      "properties": {
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "canonical_parameter_digest": { "$ref": "#/$defs/OperationSHA256" }
      },
      "additionalProperties": false
    },
    "OperationArtifactSelectorRequestData": {
      "type": "object",
      "required": ["request_id", "canonical_parameter_digest", "selector"],
      "properties": {
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "canonical_parameter_digest": { "$ref": "#/$defs/OperationSHA256" },
        "selector": {
          "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-artifact-v1.schema.json#/$defs/artifact_selector"
        }
      },
      "additionalProperties": false
    },
    "OperationArtifactReleaseRequestData": {
      "type": "object",
      "required": ["request_id", "canonical_parameter_digest", "selector", "destination"],
      "properties": {
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "canonical_parameter_digest": { "$ref": "#/$defs/OperationSHA256" },
        "selector": {
          "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-artifact-v1.schema.json#/$defs/artifact_selector"
        },
        "destination": { "type": "string", "pattern": "^/", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "StatusItemOwner": {
      "$ref": "https://agent-os.local/schemas/aos-status-item-descriptor-v1.schema.json#/$defs/id"
    },
    "StatusItemItemID": {
      "$ref": "https://agent-os.local/schemas/aos-status-item-descriptor-v1.schema.json#/$defs/id"
    },
    "StatusItemActionID": {
      "$ref": "https://agent-os.local/schemas/aos-status-item-descriptor-v1.schema.json#/$defs/path_id"
    },
    "StatusItemGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "StatusItemRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "StatusItemActionSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "StatusItemRegisterData": {
      "type": "object",
      "required": ["descriptor"],
      "additionalProperties": false,
      "properties": {
        "descriptor": { "$ref": "https://agent-os.local/schemas/aos-status-item-descriptor-v1.schema.json" }
      }
    },
    "StatusItemUpdateData": {
      "type": "object",
      "required": ["owner", "item_id", "generation", "current_revision", "descriptor"],
      "additionalProperties": false,
      "properties": {
        "owner": { "$ref": "#/$defs/StatusItemOwner" },
        "item_id": { "$ref": "#/$defs/StatusItemItemID" },
        "generation": { "$ref": "#/$defs/StatusItemGeneration" },
        "current_revision": { "$ref": "#/$defs/StatusItemRevision" },
        "descriptor": { "$ref": "https://agent-os.local/schemas/aos-status-item-descriptor-v1.schema.json" }
      }
    },
    "StatusItemInspectData": {
      "type": "object",
      "required": ["owner", "item_id", "generation", "descriptor_revision"],
      "additionalProperties": false,
      "properties": {
        "owner": { "$ref": "#/$defs/StatusItemOwner" },
        "item_id": { "$ref": "#/$defs/StatusItemItemID" },
        "generation": { "$ref": "#/$defs/StatusItemGeneration" },
        "descriptor_revision": { "$ref": "#/$defs/StatusItemRevision" }
      }
    },
    "StatusItemInvokeData": {
      "type": "object",
      "required": ["owner", "item_id", "action_id", "generation", "descriptor_revision", "action_sequence"],
      "additionalProperties": false,
      "properties": {
        "owner": { "$ref": "#/$defs/StatusItemOwner" },
        "item_id": { "$ref": "#/$defs/StatusItemItemID" },
        "action_id": { "$ref": "#/$defs/StatusItemActionID" },
        "generation": { "$ref": "#/$defs/StatusItemGeneration" },
        "descriptor_revision": { "$ref": "#/$defs/StatusItemRevision" },
        "action_sequence": { "$ref": "#/$defs/StatusItemActionSequence" }
      }
    },
    "SceneFollowData": {
      "type": "object",
      "required": ["stage", "owner", "resource", "operation"],
      "properties": {
        "stage": { "const": "desktop-world/main" },
        "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "resource": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
        "operation": {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["mount", "transact", "signal", "play", "suspend", "resume", "inspect", "remove", "close", "subscribe", "unsubscribe"] },
            "extension": { "$ref": "#/$defs/SceneExtensionReference" }
          },
          "allOf": [
            {
              "if": { "required": ["extension"] },
              "then": { "properties": { "op": { "const": "mount" } } }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "SceneExtensionReference": {
      "type": "object",
      "required": ["ownerId", "id", "digest", "sceneAbi", "threeRevision"],
      "properties": {
        "ownerId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sceneAbi": { "const": "aos.scene.projection.v1" },
        "threeRevision": { "const": "183" }
      },
      "additionalProperties": false
    },
    "SeeObserveData": {
      "type": "object",
      "properties": {
        "depth": { "type": "integer", "minimum": 0, "maximum": 3 },
        "scope": { "type": "string" },
        "rate": { "type": "string" },
        "events": { "type": "array", "items": { "type": "string" } },
        "snapshot": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "SeeCaptureDisplay": {
      "type": "object",
      "required": ["display_id", "index", "topology_ordinal"],
      "additionalProperties": false,
      "properties": {
        "display_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "index": { "type": "integer", "minimum": 0, "maximum": 15 },
        "topology_ordinal": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "SeeCaptureWindowTarget": {
      "type": "object",
      "required": ["display_id", "window_id", "owner_pid", "expected_bounds", "fallback"],
      "additionalProperties": false,
      "properties": {
        "display_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "window_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "owner_pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "expected_bounds": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "width": { "type": "integer", "minimum": 10 },
            "height": { "type": "integer", "minimum": 10 }
          }
        },
        "fallback": { "type": "string", "enum": ["display", "none"] }
      }
    },
    "SeeCaptureData": {
      "type": "object",
      "required": ["capture_id", "display_topology", "displays", "display_ids", "excluded_window_ids", "window_targets", "maximum_pixels_per_display", "shows_cursor"],
      "additionalProperties": false,
      "properties": {
        "capture_id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
        "display_topology": { "$ref": "display-topology-v1.schema.json" },
        "displays": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/SeeCaptureDisplay" } },
        "display_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 } },
        "excluded_window_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 } },
        "window_targets": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/SeeCaptureWindowTarget" } },
        "maximum_pixels_per_display": { "type": "integer", "minimum": 4, "maximum": 67108864 },
        "shows_cursor": { "type": "boolean" }
      }
    },
    "ShowCreateData": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "anchor_window": { "type": "integer" },
        "anchor_channel": { "type": "string" },
        "offset": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "html": { "type": "string" },
        "url": { "type": "string" },
        "interactive": { "type": "boolean" },
        "window_level": { "type": "string", "enum": ["automatic", "floating", "status_bar", "screen_saver"] },
        "focus": { "type": "boolean" },
        "ttl": { "type": "number" },
        "scope": { "enum": ["connection", "global"] },
        "auto_project": { "type": "string" },
        "track": { "type": "string" },
        "surface": { "type": "string", "enum": ["desktop-world"] },
        "parent": { "type": "string" },
        "cascade": { "type": "boolean" },
        "suspended": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/CanvasOwnerInfo" }
      },
      "oneOf": [
        { "required": ["at"], "not": { "required": ["surface"] } },
        { "required": ["track"], "not": { "required": ["surface"] } },
        { "required": ["anchor_window", "offset"], "not": { "required": ["surface"] } },
        { "required": ["anchor_channel", "offset"], "not": { "required": ["surface"] } },
        {
          "required": ["surface"],
          "not": {
            "anyOf": [
              { "required": ["at"] },
              { "required": ["track"] },
              { "required": ["anchor_window"] },
              { "required": ["anchor_channel"] },
              { "required": ["offset"] },
              { "required": ["auto_project"] }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "CanvasOwnerInfo": {
      "type": "object",
      "required": ["consumer_id", "harness", "pid", "cwd", "runtime_mode"],
      "properties": {
        "consumer_id": { "type": "string", "minLength": 1 },
        "harness": { "type": "string", "minLength": 1 },
        "pid": { "type": "integer", "minimum": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "worktree_root": { "type": ["string", "null"] },
        "runtime_mode": { "enum": ["repo", "installed"] }
      },
      "additionalProperties": true
    },
    "ShowUpdateData": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "html": { "type": "string" },
        "url": { "type": "string" },
        "interactive": { "type": "boolean" },
        "window_level": { "type": "string", "enum": ["automatic", "floating", "status_bar", "screen_saver"] },
        "ttl": { "type": ["number", "null"] },
        "track": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ShowEvalData": {
      "type": "object",
      "required": ["id", "js"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "js": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "ShowRemoveData": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "ShowListData": {
      "type": "object",
      "properties": { "scope": { "enum": ["connection", "global"] } },
      "additionalProperties": true
    },
    "ShowPostData": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "TellSendData": {
      "type": "object",
      "required": ["audience"],
      "properties": {
        "audience": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "text": { "type": "string" },
        "payload": { "type": "object" },
        "from_session_id": { "type": "string" },
        "from": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "oneOf": [
        { "required": ["text"] },
        { "required": ["payload"] }
      ],
      "additionalProperties": true
    },
    "ListenReadData": {
      "type": "object",
      "required": ["channel"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "since": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "SessionRegisterData": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "harness": { "type": "string" }
      },
      "additionalProperties": true
    },
    "SessionUnregisterData": {
      "type": "object",
      "anyOf": [
        { "required": ["session_id"] },
        { "required": ["name"] }
      ],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "VoiceListData": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "speakable_only": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "VoiceBindData": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "voice_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "gender": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "quality_tier": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "VoiceNextData": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "VoiceFinalResponseData": {
      "type": "object",
      "required": ["hook_payload"],
      "properties": {
        "session_id": { "type": "string" },
        "harness": { "type": "string" },
        "hook_payload": { "type": "object" }
      },
      "additionalProperties": true
    },
    "FocusSubtree": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "title": { "type": "string" },
        "identifier": { "type": "string" }
      },
      "additionalProperties": true
    },
    "FocusCreateData": {
      "type": "object",
      "required": ["id", "window_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "window_id": { "type": "integer" },
        "pid": { "type": "integer" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 15 },
        "subtree": { "$ref": "#/$defs/FocusSubtree" }
      },
      "additionalProperties": true
    },
    "FocusUpdateData": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 0, "maximum": 15 },
        "subtree": { "$ref": "#/$defs/FocusSubtree" }
      },
      "additionalProperties": true
    },
    "FocusRemoveData": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "GraphWindowsData": {
      "type": "object",
      "properties": {
        "display": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "GraphDeepenData": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 0, "maximum": 15 },
        "subtree": { "$ref": "#/$defs/FocusSubtree" }
      },
      "additionalProperties": true
    },
    "GraphCollapseData": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 0, "maximum": 15 }
      },
      "additionalProperties": true
    }
  }
}
