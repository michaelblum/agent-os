{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelblum/agent-os/shared/schemas/aos-target-handle-v1.schema.json",
  "title": "AOS Target Handle V1",
  "oneOf": [
    { "$ref": "#/$defs/browser_observation_ref" },
    { "$ref": "#/$defs/canvas_locator" },
    { "$ref": "#/$defs/native_ax_locator" }
  ],
  "$defs": {
    "browser_observation_ref": {
      "type": "object",
      "required": ["kind", "backend", "state_id", "scope", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "observation_ref" },
        "backend": { "const": "browser" },
        "state_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
        "scope": {
          "type": "object",
          "required": ["session"],
          "additionalProperties": false,
          "properties": { "session": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
        },
        "ref": { "type": "string", "pattern": "^(f[0-9]+)?e[0-9]+$" }
      }
    },
    "canvas_locator": {
      "type": "object",
      "required": ["kind", "backend", "query"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "locator" },
        "backend": { "const": "aos_canvas" },
        "query": {
          "type": "object",
          "required": ["canvas_id", "ref"],
          "additionalProperties": false,
          "properties": {
            "canvas_id": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "native_ax_locator": {
      "type": "object",
      "required": ["kind", "backend", "query"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "locator" },
        "backend": { "const": "native_ax" },
        "query": {
          "type": "object",
          "required": ["pid", "role"],
          "additionalProperties": false,
          "not": { "required": ["index", "near"] },
          "properties": {
            "pid": { "type": "integer", "minimum": 1 },
            "window_id": { "type": "integer", "minimum": 1 },
            "role": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "identifier": { "type": "string", "minLength": 1 },
            "index": { "type": "integer", "minimum": 0, "maximum": 1023 },
            "near": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?,-?[0-9]+(?:\\.[0-9]+)?$" },
            "match": { "enum": ["exact", "contains", "regex"] },
            "depth": { "type": "integer", "minimum": 0, "maximum": 128 },
            "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 30000 }
          }
        }
      }
    }
  }
}
