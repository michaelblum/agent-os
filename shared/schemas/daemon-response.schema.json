{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelblum/agent-os/shared/schemas/daemon-response.schema.json",
  "title": "Daemon Response Envelope",
  "description": "Wire contract for responses emitted by the aos daemon. Newline-delimited JSON.",
  "oneOf": [
    {
      "type": "object",
      "required": ["v", "status", "data"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.screen-recording.admission-result.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json#/$defs/admission_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.screen-recording.follow-update-result.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-screen-recording-v1.schema.json#/$defs/follow_update_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.artifact.custody-result.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-artifact-v1.schema.json#/$defs/artifact_custody_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "data": { "required": ["capture_id"] } }
          },
          "then": {
            "properties": { "data": { "$ref": "#/$defs/SeeCaptureResponseData" } }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.list-result.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-v1.schema.json#/$defs/operation_list_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.inspect-result.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-v1.schema.json#/$defs/operation_inspect_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.control-result.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-v1.schema.json#/$defs/operation_control_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.host-stop-barrier.stop-all-receipt.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-host-stop-barrier-v1.schema.json#/$defs/stop_all_receipt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.host-stop-barrier.status-receipt.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-host-stop-barrier-v1.schema.json#/$defs/barrier_status_receipt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.host-stop-barrier.reopen-receipt.v1" } }
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-host-stop-barrier-v1.schema.json#/$defs/reopen_receipt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.external-spawn-intent-response.v1" } }
              }
            }
          },
          "then": {
            "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnIntentResponseData" } }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.external-spawn-child-admit-response.v1" } }
              }
            }
          },
          "then": {
            "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnChildAdmitResponseData" } }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.external-spawn-abandon-response.v1" } }
              }
            }
          },
          "then": {
            "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnAbandonResponseData" } }
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "required": ["schema_version"],
                "properties": { "schema_version": { "const": "aos.operation.external-spawn-finalize-response.v1" } }
              }
            }
          },
          "then": {
            "properties": { "data": { "$ref": "#/$defs/OperationExternalSpawnFinalizeResponseData" } }
          }
        }
      ],
      "properties": {
        "v": { "const": 1 },
        "status": { "const": "success" },
        "data": { "type": "object" },
        "ref": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["v", "status", "error", "code"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "status": { "const": "error" },
        "error": { "type": "string" },
        "code": {
          "type": "string",
          "enum": [
            "MISSING_ARG",
            "INVALID_ARG",
            "UNKNOWN_ACTION",
            "UNKNOWN_SERVICE",
            "PARSE_ERROR",
            "SESSION_NOT_FOUND",
            "MISSING_SESSION_ID",
            "VOICE_NOT_FOUND",
            "VOICE_NOT_SPEAKABLE",
            "VOICE_NOT_ALLOCATABLE",
            "CANVAS_NOT_FOUND",
            "PERMISSION_DENIED",
            "DESKTOP_FRAME_BUSY",
            "DESKTOP_FRAME_CAPTURE_FAILED",
            "DESKTOP_FRAME_DISPLAY_NOT_FOUND",
            "DESKTOP_FRAME_PERMISSION_DENIED",
            "DESKTOP_FRAME_RETIREMENT_UNCERTAIN",
            "DESKTOP_FRAME_TOPOLOGY_MISMATCH",
            "DESKTOP_FRAME_UNAUTHORIZED",
            "DESKTOP_FRAME_UNSUPPORTED",
            "INTERNAL",
            "INVALID_STATUS_ITEM_DESCRIPTOR",
            "INVALID_STATUS_ITEM_INSPECT",
            "INVALID_STATUS_ITEM_INVOKE",
            "INVALID_STATUS_ITEM_MENU",
            "INVALID_STATUS_ITEM_SCHEMA",
            "INVALID_STATUS_ITEM_UPDATE",
            "STATUS_ITEM_ACTION_DISABLED",
            "STATUS_ITEM_ACTION_NOT_FOUND",
            "STATUS_ITEM_ACTION_SEQUENCE_EXHAUSTED",
            "STATUS_ITEM_ANCHOR_UNAVAILABLE",
            "STATUS_ITEM_EVENT_UNAVAILABLE",
            "STATUS_ITEM_IDENTITY_MISMATCH",
            "STATUS_ITEM_LEASE_BUSY",
            "STATUS_ITEM_NOT_FOUND",
            "STATUS_ITEM_REVISION_CONFLICT",
            "STATUS_ITEM_REVISION_NOT_ADVANCED",
            "STATUS_ITEM_STALE_ACTION_SEQUENCE",
            "STATUS_ITEM_STALE_GENERATION",
            "STATUS_ITEM_STALE_REVISION",
            "STATUS_ITEM_UNAVAILABLE",
            "STATUS_ITEM_UPDATE_REQUIRED",
            "OPERATION_RECORD_INVALID",
            "OPERATION_STORE_UNAVAILABLE",
            "OPERATION_STORE_CORRUPT",
            "OPERATION_STORE_LOCKED",
            "OPERATION_GENERATION_CONFLICT",
            "OPERATION_OWNER_MISMATCH",
            "OPERATION_CALLER_NOT_AUTHENTICATED",
            "OPERATION_CONTROL_ORIGIN_UNSUPPORTED",
            "OPERATION_NOT_FOUND",
            "OPERATION_TRANSITION_INVALID",
            "OPERATION_BARRIER_CLOSED",
            "OPERATION_BARRIER_NOT_CLOSED",
            "OPERATION_BARRIER_GENERATION_CONFLICT",
            "OPERATION_ADAPTER_REGISTRY_CONFLICT",
            "OPERATION_RESOURCE_DECLARATION_CONFLICT",
            "OPERATION_RESOURCE_BUSY",
            "OPERATION_RESOURCE_FANOUT_EXHAUSTED",
            "OPERATION_RESOURCE_CAS_CONFLICT",
            "OPERATION_SPAWN_RECORD_CAPACITY",
            "OPERATION_IDEMPOTENCY_CONFLICT",
            "OPERATION_RESIDUALS_PRESENT",
            "OPERATION_RECONCILIATION_INCOMPLETE",
            "OPERATION_RECOVERY_CLAIM_STALE",
            "OPERATION_TAP_UNAVAILABLE",
            "OPERATION_ARTIFACT_CUSTODY_UNAVAILABLE",
            "OPERATION_ARTIFACT_RETAIN_UNAVAILABLE"
          ]
        },
        "ref": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["v", "status", "data"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "status": { "const": "dry_run" },
        "data": { "type": "object" },
        "ref": { "type": "string" }
      }
    }
  ],
  "$defs": {
    "OperationIdentifier": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/identifier"
    },
    "OperationGeneration": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/generation"
    },
    "OperationSHA256": {
      "$ref": "https://github.com/michaelblum/agent-os/shared/schemas/aos-operation-lineage-v1.schema.json#/$defs/sha256"
    },
    "OperationExternalSpawnIntentResponseData": {
      "type": "object",
      "required": [
        "schema_version", "request_id", "spawn_record_id", "one_time_binding_token",
        "operation_id", "operation_generation", "adapter_registration_id", "adapter_registration_revision"
      ],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-intent-response.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "spawn_record_id": { "$ref": "#/$defs/OperationIdentifier" },
        "one_time_binding_token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "operation_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_generation": { "$ref": "#/$defs/OperationGeneration" },
        "adapter_registration_id": { "$ref": "#/$defs/OperationIdentifier" },
        "adapter_registration_revision": { "$ref": "#/$defs/OperationGeneration" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnReceipt": {
      "type": "object",
      "required": [
        "spawn_record_id", "operation_id", "operation_generation", "adapter_registration_id",
        "adapter_registration_revision", "resolved_executable_path_digest", "executable_identity_digest",
        "executable_file_digest", "platform_code_directory_hash", "platform_code_directory_hash_algorithm", "expected_script_identity_digest", "script_identity_digest",
        "script_digest", "canonical_argv_shape_digest", "reviewed_dependency_set_digest", "outcome"
      ],
      "properties": {
        "spawn_record_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_generation": { "$ref": "#/$defs/OperationGeneration" },
        "adapter_registration_id": { "$ref": "#/$defs/OperationIdentifier" },
        "adapter_registration_revision": { "$ref": "#/$defs/OperationGeneration" },
        "resolved_executable_path_digest": { "$ref": "#/$defs/OperationSHA256" },
        "executable_identity_digest": { "$ref": "#/$defs/OperationSHA256" },
        "executable_file_digest": { "$ref": "#/$defs/OperationSHA256" },
        "platform_code_directory_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "platform_code_directory_hash_algorithm": { "const": "sha256_truncated_cdhash_20_bytes" },
        "expected_script_identity_digest": { "$ref": "#/$defs/OperationSHA256" },
        "script_identity_digest": { "$ref": "#/$defs/OperationSHA256" },
        "script_digest": { "$ref": "#/$defs/OperationSHA256" },
        "canonical_argv_shape_digest": { "$ref": "#/$defs/OperationSHA256" },
        "reviewed_dependency_set_digest": { "$ref": "#/$defs/OperationSHA256" },
        "outcome": { "const": "generation_bound_spawn_record_finalized" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnChildAdmitResponseData": {
      "type": "object",
      "required": [
        "schema_version", "request_id", "spawn_record_id", "operation_id",
        "operation_generation", "child_pid", "child_pid_generation", "parent_edge_digest",
        "platform_code_directory_hash", "platform_code_directory_hash_algorithm", "outcome"
      ],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-child-admit-response.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "spawn_record_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_generation": { "$ref": "#/$defs/OperationGeneration" },
        "child_pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "child_pid_generation": { "$ref": "#/$defs/OperationGeneration" },
        "parent_edge_digest": { "$ref": "#/$defs/OperationSHA256" },
        "platform_code_directory_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "platform_code_directory_hash_algorithm": { "const": "sha256_truncated_cdhash_20_bytes" },
        "outcome": { "const": "generation_bound_spawn_child_admitted" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnAbandonResponseData": {
      "type": "object",
      "required": [
        "schema_version", "request_id", "spawn_record_id", "operation_id",
        "operation_generation", "outcome"
      ],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-abandon-response.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "spawn_record_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_generation": { "$ref": "#/$defs/OperationGeneration" },
        "outcome": { "const": "prepared_operation_abandoned" }
      },
      "additionalProperties": false
    },
    "OperationExternalSpawnFinalizeResponseData": {
      "type": "object",
      "required": [
        "schema_version", "request_id", "spawn_record_id", "operation_id", "operation_generation",
        "adapter_registration_id", "adapter_registration_revision", "outcome", "receipt"
      ],
      "properties": {
        "schema_version": { "const": "aos.operation.external-spawn-finalize-response.v1" },
        "request_id": { "$ref": "#/$defs/OperationIdentifier" },
        "spawn_record_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_id": { "$ref": "#/$defs/OperationIdentifier" },
        "operation_generation": { "$ref": "#/$defs/OperationGeneration" },
        "adapter_registration_id": { "$ref": "#/$defs/OperationIdentifier" },
        "adapter_registration_revision": { "$ref": "#/$defs/OperationGeneration" },
        "outcome": { "const": "generation_bound_spawn_record_finalized" },
        "receipt": { "$ref": "#/$defs/OperationExternalSpawnReceipt" }
      },
      "additionalProperties": false
    },
    "SeeCaptureFrame": {
      "type": "object",
      "required": [
        "display_id",
        "frame_index",
        "chunk_count",
        "byte_count",
        "sha256",
        "width",
        "height",
        "capture_source",
        "window_fallback"
      ],
      "additionalProperties": false,
      "properties": {
        "display_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "frame_index": { "type": "integer", "minimum": 0, "maximum": 15 },
        "chunk_count": { "type": "integer", "minimum": 1, "maximum": 336592896 },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 336592896 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "height": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "capture_source": { "enum": ["display", "window"] },
        "window_fallback": { "type": "boolean" },
        "window_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "allOf": [
        {
          "if": { "properties": { "capture_source": { "const": "window" } } },
          "then": {
            "required": ["window_id"],
            "properties": { "window_fallback": { "const": false } }
          },
          "else": { "not": { "required": ["window_id"] } }
        }
      ]
    },
    "SeeCaptureResponseData": {
      "type": "object",
      "required": ["capture_id", "topology_identity", "frames"],
      "additionalProperties": false,
      "properties": {
        "capture_id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
        "topology_identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/SeeCaptureFrame" }
        }
      }
    },
    "JSONValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/JSONValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/JSONValue" } }
      ]
    },
    "VoiceCapabilities": {
      "type": "object",
      "required": ["local", "streaming", "ssml", "speak_supported"],
      "additionalProperties": false,
      "properties": {
        "local": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "ssml": { "type": "boolean" },
        "speak_supported": { "type": "boolean" }
      }
    },
    "VoiceAvailability": {
      "type": "object",
      "required": ["installed", "enabled", "reachable"],
      "additionalProperties": false,
      "properties": {
        "installed": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "reachable": { "type": "boolean" }
      }
    },
    "ProviderAvailability": {
      "type": "object",
      "required": ["reachable"],
      "additionalProperties": false,
      "properties": {
        "reachable": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "VoiceRecord": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "provider_voice_id",
        "name",
        "gender",
        "kind",
        "quality_tier",
        "tags",
        "capabilities",
        "availability",
        "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "provider_voice_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string" },
        "locale": { "type": "string" },
        "language": { "type": "string" },
        "region": { "type": "string" },
        "gender": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "quality_tier": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "capabilities": { "$ref": "#/$defs/VoiceCapabilities" },
        "availability": { "$ref": "#/$defs/VoiceAvailability" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JSONValue" }
        }
      }
    },
    "ProviderInfo": {
      "type": "object",
      "required": ["name", "availability", "voice_count", "enabled"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "availability": { "$ref": "#/$defs/ProviderAvailability" },
        "voice_count": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
