        "tests/desktop-pixel-broker-contract.test.mjs",
        "tests/lib/desktop-frame-warm-pool-tests.swift",
        "tests/lib/daemon-appkit-readiness-tests.swift",
        "tests/lib/desktop-pixel-broker-tests.swift",
        "tests/lib/desktop-pixel-capture-filter-tests.swift",
        "tests/lib/desktop-pixel-native-lifecycle-tests.swift",
        "tests/lib/desktop-pixel-terminal-startup-tests.swift",
        "tests/lib/desktop-pixel-startup-callback-tests.swift",
        "tests/lib/desktop-pixel-warm-open-operation-tests.swift",
        "tests/lib/desktop-world-display-geometry-tests.swift",
        "tests/aos-permissions-microphone-authority.test.mjs",
        "tests/daemon-desktop-world-devtools-contract.test.mjs",
        "tests/toolkit/desktop-world-scene-*.test.mjs",
        "tests/toolkit/desktop-world-session.test.mjs",
        "tests/toolkit/scene-*.test.mjs"
      ],
      "classes": [
        "toolkit",
        "command_contract",
        "scene_engine"
      ],
      "actions": [
        "focused_test",
        "help_contract"
      ],
      "hot_swappable": true,
      "tcc_identity_sensitive": false,
      "commands": [
        {
          "id": "daemon-appkit-readiness",
          "command": "node --test tests/daemon-appkit-readiness.test.mjs",
          "reason": "Prove daemon socket admission begins only after AppKit launch and one queued main-loop turn."
        },
        {
          "id": "swift-runtime-typecheck",
          "command": "bash tests/swift-runtime-typecheck.sh",
          "reason": "Typecheck the complete Swift runtime graph without creating or executing the repo AOS binary."
        },
        {
          "id": "scene-daemon-contract",
          "command": "node --test tests/desktop-world-scene-effect-trigger.test.mjs tests/desktop-world-scene-event-routing.test.mjs tests/desktop-world-scene-framebuffer-proof-result.test.mjs tests/desktop-world-native-effect-program.test.mjs tests/desktop-world-scene-native-feedback.test.mjs tests/desktop-world-scene-native-feedback-lifecycle.test.mjs tests/desktop-world-scene-native-orchestration.test.mjs tests/desktop-world-scene-result-coordinator.test.mjs tests/desktop-world-scene-stage-readiness.test.mjs tests/daemon/aos-scheme-handler-nonblocking.test.mjs tests/daemon-desktop-world-devtools-contract.test.mjs tests/scene-follow-cli.test.mjs",
          "reason": "Verify semantic effect triggering without system input, canonical event routing diagnostics, atomic native-feedback authorization and disposal, the daemon scene lifecycle aggregate, all-segment barrier ownership, DevTools delegation, and bounded follow transport."
        },
        {
          "id": "scene-core-contract",
          "command": "node --test tests/toolkit/desktop-world-client.test.mjs tests/toolkit/desktop-world-scene-render-coordinator.test.mjs tests/toolkit/scene-cartridge.test.mjs tests/toolkit/scene-document.test.mjs tests/toolkit/scene-generic-three.test.mjs tests/toolkit/scene-host.test.mjs tests/toolkit/scene-public-contract.test.mjs tests/toolkit/scene-render-pass.test.mjs",
          "reason": "Verify the canonical document, cartridge, transaction, host, mixed render passes, cross-display camera projection, generic projection, client, and focused package boundaries."
        },
        {
          "id": "scene-interaction-contract",
          "command": "node --test tests/toolkit/scene-native-effect-program.test.mjs tests/toolkit/scene-interaction.test.mjs tests/toolkit/scene-radial-menu.test.mjs tests/toolkit/scene-interaction-visual.test.mjs tests/toolkit/scene-historical-fast-travel-reference.test.mjs tests/toolkit/desktop-world-scene-interaction-runtime.test.mjs tests/toolkit/desktop-world-scene-interaction-three.test.mjs tests/toolkit/desktop-world-scene-operation-coordinator.test.mjs tests/toolkit/desktop-world-scene-outlet.test.mjs tests/toolkit/desktop-world-scene-outlet-replacement.test.mjs",
          "reason": "Verify bounded V1, V2, and stateful V3 native effect programs, Metal and trusted Three-preview compilation, gesture arbitration, native-region atomicity, generic responses, fixed-clock visuals, historical references, and bounded Three lifecycle."
        },
        {
          "id": "scene-devtools-contract",
          "command": "node --test tests/toolkit/desktop-world-devtools-model.test.mjs tests/toolkit/desktop-world-devtools-view.test.mjs tests/toolkit/desktop-world-devtools-compat.test.mjs",
          "reason": "Verify host-neutral DevTools state, views, compatibility projections, bounded telemetry, and disabled instrumentation cost."
        },
        {
          "id": "scene-cursor-presentation-contract",
          "command": "node --test tests/daemon/input-region-cursor-suppression.test.mjs && bash tests/daemon-input-surface-ownership.sh",
          "reason": "Verify hover/capture cursor arbitration, checked native hide/show balance, generation-bound visual delivery, input independence, and lifecycle cleanup."
        },
        {
          "id": "scene-agent-authoring-contract",
          "command": "node --test tests/toolkit/desktop-world-session.test.mjs tests/toolkit/scene-public-contract.test.mjs tests/toolkit/toolkit-api-docs-contract.test.mjs tests/scene-scaffold-cli.test.mjs tests/scene-agent-authoring-acceptance.test.mjs",
          "reason": "Verify the high-level session, focused exports, deterministic scaffolds, split guides, and empty-directory agent route."
        },
