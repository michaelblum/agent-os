            "supports_json_flag": false
          },
          "usage": "aos focus list"
        },
        {
          "args": [
            {
              "id": "id",
              "kind": "flag",
              "required": true,
              "summary": "Channel name",
              "token": "--id",
              "value_type": "string"
            },
            {
              "id": "backend",
              "kind": "flag",
              "required": true,
              "summary": "Exact removal authority; browser closes or detaches the managed session and native routes only to the daemon",
              "token": "--backend",
              "value_type": {
                "enum": [
                  {
                    "summary": "Managed browser session authority",
                    "value": "browser"
                  },
                  {
                    "summary": "Native focus-channel authority",
                    "value": "native"
                  }
                ]
              }
            }
          ],
          "examples": [
            "aos focus remove --id work --backend native",
            "aos focus remove --id browser-work --backend browser"
          ],
          "execution": {
            "auto_starts_daemon": true,
            "interactive": false,
            "mutates_state": true,
            "read_only": false,
            "requires_permissions": false,
            "streaming": false,
            "supports_dry_run": false
          },
          "id": "focus-remove",
          "output": {
            "default_mode": "json",
            "error_mode": "json_stderr",
            "streaming": false,
            "supports_json_flag": false
          },
          "usage": "aos focus remove --id <name> --backend browser|native"
        }
      ],
      "path": [
        "focus"
      ],
      "summary": "Focus channels — track native windows or managed browser sessions"
    }
  ]
