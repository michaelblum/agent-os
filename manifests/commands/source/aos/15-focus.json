              "kind": "flag",
              "required": false,
              "summary": "New traversal depth from 0 through 15",
              "token": "--depth",
              "value_type": "int"
            },
            {
              "id": "subtree-role",
              "kind": "flag",
              "required": false,
              "summary": "New role filter",
              "token": "--subtree-role",
              "value_type": "string"
            },
            {
              "id": "subtree-title",
              "kind": "flag",
              "required": false,
              "summary": "New title filter",
              "token": "--subtree-title",
              "value_type": "string"
            },
            {
              "id": "subtree-identifier",
              "kind": "flag",
              "required": false,
              "summary": "New identifier filter",
              "token": "--subtree-identifier",
              "value_type": "string"
            }
          ],
          "examples": [
            "aos focus update --id work --depth 3"
          ],
          "execution": {
            "auto_starts_daemon": true,
            "interactive": false,
            "mutates_state": true,
            "read_only": false,
            "requires_permissions": true,
            "streaming": false,
            "supports_dry_run": false
          },
          "id": "focus-update",
          "output": {
            "default_mode": "json",
            "error_mode": "json_stderr",
            "streaming": false,
            "supports_json_flag": false
          },
          "usage": "aos focus update --id <name> [options]"
        },
        {
          "args": [],
