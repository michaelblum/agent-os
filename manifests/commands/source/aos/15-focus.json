{
  "schema_version": 1,
  "id": "focus",
  "path_prefix": [
    "focus"
  ],
  "commands": [
    {
      "forms": [
        {
          "args": [
            {
              "id": "id",
              "kind": "flag",
              "required": true,
              "summary": "Channel name",
              "token": "--id",
              "value_type": "string"
            },
            {
              "id": "window",
              "kind": "flag",
              "required": false,
              "summary": "Exact native window ID to track (mutually exclusive with --target; requires current AX root)",
              "token": "--window",
              "value_type": "int"
            },
            {
              "id": "target",
              "kind": "flag",
              "required": false,
              "summary": "Target URI: browser://attach or browser://new (mutually exclusive with --window)",
              "token": "--target",
              "value_type": {
                "enum": [
                  {
                    "summary": "Attach to an existing browser through an extension or CDP endpoint",
                    "value": "browser://attach"
                  },
                  {
                    "summary": "Launch and track system Chrome (Chrome must already be installed)",
                    "value": "browser://new"
                  }
                ]
              }
            },
            {
              "id": "pid",
              "kind": "flag",
              "required": false,
              "summary": "Optional native owner assertion; must match the live window owner",
              "token": "--pid",
              "value_type": "int"
            },
            {
              "id": "depth",
              "kind": "flag",
              "required": false,
              "summary": "AX traversal depth from 0 through 15",
              "token": "--depth",
              "value_type": "int"
            },
            {
              "id": "subtree-role",
              "kind": "flag",
              "required": false,
              "summary": "Filter by AX role",
              "token": "--subtree-role",
              "value_type": "string"
            },
            {
              "id": "subtree-title",
              "kind": "flag",
              "required": false,
              "summary": "Filter by title",
              "token": "--subtree-title",
              "value_type": "string"
            },
            {
              "id": "subtree-identifier",
              "kind": "flag",
              "required": false,
              "summary": "Filter by identifier",
              "token": "--subtree-identifier",
              "value_type": "string"
            },
            {
              "id": "extension",
              "kind": "flag",
              "required": false,
              "summary": "Attach via browser extension (browser://attach)",
              "token": "--extension",
              "value_type": {
                "enum": [
                  {
                    "summary": "Use the reviewed Chrome extension bridge from an ordinary Default or Profile N system Chrome profile with a valid version directory and matching manifest; may launch or focus Chrome and open its bridge page",
                    "value": "chrome"
                  }
                ]
              }
            },
            {
              "id": "cdp",
              "kind": "flag",
              "required": false,
              "summary": "Attach via CDP endpoint (browser://attach)",
              "token": "--cdp",
              "value_type": "string"
            },
            {
              "id": "headless",
              "kind": "flag",
              "required": false,
              "summary": "Launch system Chrome headless (browser://new; Chrome is an external prerequisite)",
              "token": "--headless",
              "value_type": "bool"
            },
            {
              "id": "url",
              "kind": "flag",
              "required": false,
              "summary": "Initial http, https, data, or about URL for launched browser (browser://new)",
              "token": "--url",
              "value_type": "string"
            },
            {
              "id": "persistent",
              "kind": "flag",
              "required": false,
              "summary": "Use an AOS-owned profile private to this session generation (browser://new)",
              "token": "--persistent",
              "value_type": "bool"
            }
          ],
          "constraints": {
            "conflicts": [
              [
                "window",
                "target"
              ],
              [
                "target",
                "pid"
              ],
              [
                "target",
                "depth"
              ],
              [
                "target",
                "subtree-role"
              ],
              [
                "target",
                "subtree-title"
              ],
              [
                "target",
                "subtree-identifier"
              ],
              [
                "window",
                "extension"
              ],
              [
                "window",
                "cdp"
              ],
              [
                "window",
                "headless"
              ],
              [
                "window",
                "url"
              ],
              [
                "window",
                "persistent"
              ],
              [
                "extension",
                "cdp"
              ],
              [
                "extension",
                "headless"
              ],
              [
                "extension",
                "url"
              ],
              [
                "extension",
                "persistent"
              ],
              [
                "cdp",
                "headless"
              ],
              [
                "cdp",
                "url"
              ],
              [
                "cdp",
                "persistent"
              ]
            ],
            "one_of": [
              [
                "window",
                "target"
              ]
            ]
          },
          "examples": [
            "aos focus create --id work --window 1234 --depth 2",
            "aos focus create --id todo --target browser://attach --extension=chrome",
            "aos focus create --id scratch --target browser://new --headless --url https://example.com"
          ],
          "execution": {
            "auto_starts_daemon": true,
            "interactive": false,
            "mutates_state": true,
            "read_only": false,
            "requires_permissions": true,
            "streaming": false,
            "supports_dry_run": false
          },
          "id": "focus-create",
          "output": {
            "default_mode": "json",
            "error_mode": "json_stderr",
            "streaming": false,
            "supports_json_flag": false
          },
          "usage": "aos focus create --id <name> (--window <wid> | --target browser://<kind>) [options]"
        },
        {
          "args": [
            {
              "id": "id",
              "kind": "flag",
