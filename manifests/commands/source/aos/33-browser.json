{
  "schema_version": 1,
  "id": "browser",
  "path_prefix": ["browser"],
  "commands": [
    {
      "consumer_discovery": false,
      "path": ["browser"],
      "summary": "Narrow internal helpers for managed browser targets and observations",
      "forms": [
        {
          "id": "browser-parse-target",
          "usage": "aos browser _parse-target <target>",
          "examples": ["aos browser _parse-target browser:todo"],
          "args": [{"id":"target","kind":"positional","required":true,"summary":"Managed browser session target","value_type":"string"}],
          "execution": {"auto_starts_daemon":false,"interactive":false,"mutates_state":false,"read_only":true,"requires_permissions":false,"streaming":false,"supports_dry_run":false},
          "output": {"default_mode":"json","error_mode":"json_stderr","streaming":false,"supports_json_flag":false}
        },
        {
          "id": "browser-parse-snapshot",
          "usage": "aos browser _parse-snapshot <markdown-file>",
          "examples": ["aos browser _parse-snapshot /tmp/snapshot.md"],
          "args": [{"id":"path","kind":"positional","required":true,"summary":"Managed snapshot markdown file","value_type":"string"}],
          "execution": {"auto_starts_daemon":false,"interactive":false,"mutates_state":false,"read_only":true,"requires_permissions":false,"streaming":false,"supports_dry_run":false},
          "output": {"default_mode":"json","error_mode":"json_stderr","streaming":false,"supports_json_flag":false}
        },
        {
          "id": "browser-identity",
          "usage": "aos browser _identity --session=<id>",
          "examples": ["aos browser _identity --session=todo"],
          "args": [{"id":"session","kind":"flag","token":"--session","required":true,"summary":"Managed public session ID","value_type":"string"}],
          "execution": {"auto_starts_daemon":false,"interactive":false,"mutates_state":false,"read_only":true,"requires_permissions":false,"streaming":false,"supports_dry_run":false},
          "output": {"default_mode":"json","error_mode":"json_stderr","streaming":false,"supports_json_flag":false}
        },
        {
          "id": "browser-page-identity",
          "usage": "aos browser _page-identity --session=<id>",
          "examples": ["aos browser _page-identity --session=todo"],
          "args": [{"id":"session","kind":"flag","token":"--session","required":true,"summary":"Managed public session ID","value_type":"string"}],
          "execution": {"auto_starts_daemon":false,"interactive":false,"mutates_state":false,"read_only":true,"requires_permissions":false,"streaming":false,"supports_dry_run":false},
          "output": {"default_mode":"json","error_mode":"json_stderr","streaming":false,"supports_json_flag":false}
        }
      ]
    }
  ]
}
