{
  "schema_version": 1,
  "id": "screen-recording",
  "path_prefix": ["record"],
  "commands": [
    {
      "path": ["record"],
      "summary": "Create bounded file-producing recordings.",
      "forms": [
        {
          "id": "record-screen",
          "usage": "aos record screen [--display <main|external|ordinal>] [--window-id <id> | --region <x,y,width,height>] --duration-ms <1...300000> [--system-audio] [--microphone] [--frame-rate <1...60>] [--max-pixel-count <4...33177600>] [--max-queue-frames <1...8>] [--max-output-bytes <1024...1073741824>] --json",
          "args": [
            {"id": "screen", "kind": "positional", "required": true, "value_type": "literal", "literal": "screen", "summary": "Record one fixed screen-video target"},
            {"id": "display", "kind": "flag", "token": "--display", "required": false, "value_type": "string", "summary": "Exact main, external, or display ordinal; defaults to main"},
            {"id": "window-id", "kind": "flag", "token": "--window-id", "required": false, "value_type": "integer", "summary": "Exact current native window id"},
            {"id": "region", "kind": "flag", "token": "--region", "required": false, "value_type": "string", "summary": "Global x,y,width,height wholly within the selected display"},
            {"id": "duration-ms", "kind": "flag", "token": "--duration-ms", "required": true, "value_type": "integer", "summary": "Hard duration bound: 1 through 300000 milliseconds"},
            {"id": "system-audio", "kind": "flag", "token": "--system-audio", "required": false, "value_type": "bool", "summary": "Select the optional same-stream AAC-LC system-audio track"},
            {"id": "microphone", "kind": "flag", "token": "--microphone", "required": false, "value_type": "bool", "summary": "Select the optional daemon-owned AAC-LC microphone track"},
            {"id": "frame-rate", "kind": "flag", "token": "--frame-rate", "required": false, "value_type": "integer", "summary": "Hard frame-rate bound: 1 through 60; default 30"},
            {"id": "max-pixel-count", "kind": "flag", "token": "--max-pixel-count", "required": false, "value_type": "integer", "summary": "Hard output pixel bound: 4 through 33177600; default 33177600"},
            {"id": "max-queue-frames", "kind": "flag", "token": "--max-queue-frames", "required": false, "value_type": "integer", "summary": "Hard native queue bound: 1 through 8; default 3"},
            {"id": "max-output-bytes", "kind": "flag", "token": "--max-output-bytes", "required": false, "value_type": "integer", "summary": "Hard file-size bound: 1024 through 1073741824 bytes; default 268435456"},
            {"id": "json", "kind": "flag", "token": "--json", "required": true, "value_type": "bool", "summary": "Emit machine-readable admission"}
          ],
          "examples": [
            "aos record screen --display main --duration-ms 10000 --json",
            "aos record screen --display 1 --region 0,0,1280,720 --duration-ms 5000 --frame-rate 30 --json",
            "aos record screen --display main --duration-ms 10000 --system-audio --json",
            "aos record screen --display main --duration-ms 10000 --microphone --json"
          ],
          "execution": {
            "auto_starts_daemon": true,
            "interactive": false,
            "mutates_state": true,
            "read_only": false,
            "requires_permissions": true,
            "streaming": false,
            "supports_dry_run": false
          },
          "output": {
            "default_mode": "json",
            "error_mode": "json_stderr",
            "streaming": false,
            "supports_json_flag": true
          }
        }
      ]
    }
  ]
}
