{
  "schema_version": 1,
  "id": "browser",
  "commands": [
    {
      "path": ["browser"],
      "summary": "Route narrow managed browser helpers.",
      "executable": "/usr/bin/env",
      "argv_prefix": ["node", "$AOS_REPO_ROOT/scripts/aos-browser-internal.mjs"],
      "cwd": "$AOS_REPO_ROOT",
      "env": {"AOS_REPO_ROOT":"$AOS_REPO_ROOT","AOS_RUNTIME_MODE":"$AOS_RUNTIME_MODE","AOS_STATE_ROOT":"$AOS_STATE_ROOT"}
    },
    {
      "path": ["browser", "_parse-target"],
      "summary": "Parse an exact managed browser target.",
      "executable": "/usr/bin/env",
      "argv_prefix": ["node", "$AOS_REPO_ROOT/scripts/aos-browser-internal.mjs", "_parse-target"],
      "cwd": "$AOS_REPO_ROOT",
      "env": {"AOS_REPO_ROOT":"$AOS_REPO_ROOT","AOS_RUNTIME_MODE":"$AOS_RUNTIME_MODE","AOS_STATE_ROOT":"$AOS_STATE_ROOT"}
    },
    {
      "path": ["browser", "_parse-snapshot"],
      "summary": "Parse managed snapshot markdown.",
      "executable": "/usr/bin/env",
      "argv_prefix": ["node", "$AOS_REPO_ROOT/scripts/aos-browser-internal.mjs", "_parse-snapshot"],
      "cwd": "$AOS_REPO_ROOT",
      "env": {"AOS_REPO_ROOT":"$AOS_REPO_ROOT","AOS_RUNTIME_MODE":"$AOS_RUNTIME_MODE","AOS_STATE_ROOT":"$AOS_STATE_ROOT"}
    },
    {
      "path": ["browser", "_identity"],
      "summary": "Read a managed browser session identity.",
      "executable": "/usr/bin/env",
      "argv_prefix": ["node", "$AOS_REPO_ROOT/scripts/aos-browser-internal.mjs", "_identity"],
      "cwd": "$AOS_REPO_ROOT",
      "env": {"AOS_REPO_ROOT":"$AOS_REPO_ROOT","AOS_RUNTIME_MODE":"$AOS_RUNTIME_MODE","AOS_STATE_ROOT":"$AOS_STATE_ROOT"}
    },
    {
      "path": ["browser", "_page-identity"],
      "summary": "Read a bounded managed page identity.",
      "executable": "/usr/bin/env",
      "argv_prefix": ["node", "$AOS_REPO_ROOT/scripts/aos-browser-internal.mjs", "_page-identity"],
      "cwd": "$AOS_REPO_ROOT",
      "env": {"AOS_REPO_ROOT":"$AOS_REPO_ROOT","AOS_RUNTIME_MODE":"$AOS_RUNTIME_MODE","AOS_STATE_ROOT":"$AOS_STATE_ROOT"}
    }
  ]
}
