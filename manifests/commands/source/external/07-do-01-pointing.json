{
  "schema_version": 1,
  "id": "do-01-pointing",
  "commands": [
    {
      "path": [
        "do",
        "click"
      ],
      "summary": "Load saved click handles; canvas Locators may dispatch, while browser Observation Refs fail closed without current-generation or worker dispatch.",
      "executable": "/usr/bin/env",
      "argv_prefix": [
        "node",
        "scripts/aos-do-ref.mjs",
        "click"
      ],
      "cwd": "repo",
      "when": {
        "child_arg_index": 0,
        "prefix": "ref:"
      },
      "env": {
        "AOS_PATH": "$AOS_PATH",
        "AOS_INVOCATION_DISPLAY_NAME": "$AOS_INVOCATION_DISPLAY_NAME",
        "AOS_RUNTIME_MODE": "$AOS_RUNTIME_MODE",
        "AOS_STATE_ROOT": "$AOS_STATE_ROOT"
      }
    },
    {
      "path": [
        "do",
        "click"
      ],
      "summary": "Parse exact direct browser-ref click grammar, then fail closed with TARGET_ACTION_UNSUPPORTED before session or worker dispatch.",
      "executable": "/usr/bin/env",
      "argv_prefix": [
        "node",
        "$AOS_REPO_ROOT/scripts/aos-do-browser.mjs",
        "click"
      ],
      "cwd": "$AOS_REPO_ROOT",
      "when": {
        "child_arg_index": 0,
        "prefix": "browser:"
      },
      "env": {
        "AOS_PATH": "$AOS_PATH",
        "AOS_INVOCATION_DISPLAY_NAME": "$AOS_INVOCATION_DISPLAY_NAME",
        "AOS_RUNTIME_MODE": "$AOS_RUNTIME_MODE",
        "AOS_STATE_ROOT": "$AOS_STATE_ROOT"
      }
    },
    {
      "path": [
        "do",
        "click"
      ],
      "summary": "Click a current canvas semantic target through the external do canvas command.",
      "executable": "/usr/bin/env",
      "argv_prefix": [
        "node",
        "scripts/aos-do-canvas.mjs",
        "click"
      ],
      "cwd": "repo",
      "when": {
        "child_arg_index": 0,
        "prefix": "canvas:"
      },
      "env": {
        "AOS_PATH": "$AOS_PATH",
        "AOS_RUNTIME_MODE": "$AOS_RUNTIME_MODE",
        "AOS_STATE_ROOT": "$AOS_STATE_ROOT"
      }
    },
    {
      "path": [
        "do",
        "click"
      ],
      "summary": "Click a native input target through the external do native command.",
      "executable": "/usr/bin/env",
      "argv_prefix": [
        "node",
        "scripts/aos-do-native.mjs",
        "click"
      ],
      "cwd": "repo",
      "when": {
        "child_arg_index": 0,
        "excluded_prefixes": [
          "browser:",
          "ref:",
          "canvas:"
        ]
      },
      "env": {
        "AOS_PATH": "$AOS_PATH",
        "AOS_RUNTIME_MODE": "$AOS_RUNTIME_MODE",
        "AOS_STATE_ROOT": "$AOS_STATE_ROOT"
      }
    },
